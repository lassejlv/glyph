{
  "name": "glyph-svg",
  "version": "0.1.0",
  "description": "1000+ clean SVG icons in outline and solid styles, behind one type-safe getIcon() function.",
  "keywords": [
    "icons",
    "svg",
    "icon-set",
    "outline",
    "solid",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lassejlv/glyph.git"
  },
  "homepage": "https://github.com/lassejlv/glyph#readme",
  "bugs": "https://github.com/lassejlv/glyph/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "new": "node scripts/new.mjs",
    "brand": "node scripts/add-brand.mjs",
    "prepublishOnly": "npm run build && npm run check",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
